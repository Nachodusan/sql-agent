# Any OpenAI-compatible endpoint. Defaults below target DeepInfra.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepinfra.com/v1/openai
SQL_AGENT_MODEL=deepseek-ai/DeepSeek-V3

# Cost accounting, USD per million tokens. Used only for the trace numbers.
SQL_AGENT_COST_IN=0.25
SQL_AGENT_COST_OUT=0.85

# Safety rails
SQL_AGENT_MAX_STEPS=12
SQL_AGENT_SQL_TIMEOUT_S=5
